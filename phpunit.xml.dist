<?xml version="1.0" encoding="UTF-8"?>
<!-- https://docs.phpunit.de/en/11.5/configuration.html - PHPUnit 10.5 & 11 -->
<phpunit
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
        backupGlobals="false"
        colors="true"
        processIsolation="false"
        stopOnFailure="true"
        cacheResult="false"
        bootstrap="vendor/autoload_runtime.php"
>

  <testsuites>
      <testsuite name="Core">
          <directory>./tests/Core/</directory>
      </testsuite>
      <testsuite name="Integration">
          <directory>./tests/Integration/</directory>
      </testsuite>
      <testsuite name="Operational">
          <directory>./tests/Operational/</directory>
      </testsuite>
  </testsuites>

  <php>
      <server name="KERNEL_CLASS" value="BadPixxel\Widgets\Tests\Kernel"/>
      <server name="KERNEL_DIR" value="tests/"/>
      <env name="SYMFONY_DEPRECATIONS_HELPER" value="disabled"/>
  </php>

</phpunit>
