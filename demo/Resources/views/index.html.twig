{% extends "base.html.twig" %}

{% block title %}
    Welcome to BadPixxel Widgets Bundle Demo !
{% endblock %}

{% block page_content %}
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-success">
                <h4><i class="fa fa-check-circle"></i> Welcome to BadPixxel Widgets Bundle!</h4>
                <p>
                    This demo showcases static widget rendering using class-based loading.
                    Widgets are loaded in the controller using <code>WidgetsResolver::resolve(WidgetClass::class)</code>.
                </p>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 mb-4">
            <h3><i class="fa fa-font"></i> Text Widget Demo</h3>
            <p class="text-muted">Demonstration of a configurable text widget with HTML support.</p>
            <twig:Widget
                    :configurator="textConfigurator"
                    configuration="{{ { "mode": bsMode } }}"
                    loading="defer"
            />

        </div>

        <div class="col-lg-6 mb-4">
            <h3><i class="fa fa-clock"></i> Cache Status Widget</h3>
            <p class="text-muted">Shows widget caching capabilities with generation timestamp.</p>
            <twig:Widget
                    :configurator="cacheConfigurator"
                    configuration="{{ { "mode": bsMode } }}"
                    loading="defer"
            />
        </div>
    </div>

    <hr class="my-5">

    <div class="row">
        <div class="col-12">
            <h3><i class="fa fa-code"></i> How to Use Widgets</h3>
            <p>Widgets are loaded in the controller using the <code>WidgetsResolver</code> service:</p>
            <pre><code class="language-php">public function __construct(
    private readonly WidgetsResolver $widgetsResolver
) {
}

public function myAction(): Response
{
    // Load widget configurator by class
    $configurator = $this->widgetsResolver->resolve(Text::class, true);

    return $this->render('template.html.twig', [
        'configurator' => $configurator,
    ]);
}</code></pre>

            <p>Then render the widget in your template:</p>
            <pre><code class="language-twig">{% apply trim|spaceless|raw %}
&lt;twig:Widget
    :configurator="configurator"
    configuration="&#123;&#123; &#123; "mode": "bs5" &#125; &#125;&#125;"
/&gt;
            {% endapply %}</code></pre>
        </div>
    </div>

{% endblock %}