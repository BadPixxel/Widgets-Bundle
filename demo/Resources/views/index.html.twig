{% extends "base.html.twig" %}

{% block title %}
    Shop Dashboard
    <small class="text-muted h6">Static widgets, with demo data</small>
{% endblock %}

{% block page_content %}

    {#
     # Static Dashboard: each widget sets its own width, header, footer & border in its attribute options.
     # Rendered inline (not deferred) and not editable, like on a real dashboard page.
     #}
    <div class="row">
        {% for configurator in dashboard %}
            <twig:Widget
                    :configurator="configurator"
                    configuration="{{ { mode: bsMode, deferred: false, editable: false } }}"
            />
        {% endfor %}
    </div>

    <hr class="my-5">

    <div class="row">
        <div class="col-12">
            <h3><i class="fa fa-code"></i> How to Use Widgets</h3>
            <p>Widgets are loaded in the controller using the <code>WidgetsResolver</code> service:</p>
            <pre><code class="language-php">public function __construct(
    private readonly WidgetsResolver $widgetsResolver
) {
}

public function myAction(): Response
{
    // Load widget configurator by class
    $configurator = $this->widgetsResolver->resolve(SalesOverview::class);

    return $this->render('template.html.twig', [
        'configurator' => $configurator,
    ]);
}</code></pre>

            <p>Then render the widget in your template:</p>
            <pre><code class="language-twig">{% apply trim|spaceless|raw %}
&lt;twig:Widget
    :configurator="configurator"
    configuration="&#123;&#123; &#123; "mode": "bs5" &#125; &#125;&#125;"
/&gt;
            {% endapply %}</code></pre>

            <p>Width, header, footer & border are widget options, set in its attribute:</p>
            <pre><code class="language-php">#[AsStaticWidget(
    channels: array("dashboard"),
    options: array(
        Options::WIDTH => WidgetWidth::XS,
        Options::SHOW_HEADER => false,
        Options::SHOW_FOOTER => false,
    )
)]
class KpiRevenue extends AbstractWidget</code></pre>
        </div>
    </div>

{% endblock %}
