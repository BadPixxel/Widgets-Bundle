{% extends "base.html.twig" %}

{% block title %}
    Widget as Sonata Block: <twig:Widgets:Widget:Title :widget="Widget" />
    <br />
    <small><code>{{ Configurator.class }}</code></small>
{% endblock %}

{% block page_content %}
    <div class="row">

        <div class="col-12 col-md-6">
            <h5><i class="fa fa-fw fa-code"></i> Example</h5>
<pre><code class="language-twig">{% verbatim %}{{ sonata_block_render({ 'type': 'badpixxel.widget.simple' }, {
    configurator:   configurator,
    options:        options,
}) }}{% endverbatim %}</code></pre>
        </div>

        <div class="col-12 col-md-6">
            <h5><i class="fa fa-fw fa-eye"></i> Widget Preview (as Sonata Block)</h5>
            {{ sonata_block_render({ 'type': 'badpixxel.widget.simple' }, {
                configurator:   Configurator,
                options:        Options,
            }) }}
        </div>

    </div>
{% endblock %}
