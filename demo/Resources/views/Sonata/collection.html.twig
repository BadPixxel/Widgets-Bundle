{% extends "base.html.twig" %}

{% block title %}
    Widgets Collection as Sonata Block
{% endblock %}

{% block page_content %}
    <div class="row">

        <div class="col-12 col-md-6">
            <h5><i class="fa fa-fw fa-info-circle"></i> Render a Widgets Collection with Sonata Blocks</h5>
            <p>
                Just pass a collection type and a channel, that's all.
                If the collection type is new, it is created & persisted to database,
                so you can create new collections on demand.
                A few options hide the toolbar or disable edition.
            </p>
        </div>

        <div class="col-12 col-md-6">
            <h5><i class="fa fa-fw fa-code"></i> Example</h5>
<pre><code class="language-twig">{% verbatim %}{{ sonata_block_render({ 'type': 'badpixxel.widgets.collection' }, {
    'type':     'my-dashboard',
    'channel':  'demo',
}) }}{% endverbatim %}</code></pre>
        </div>

        <div class="col-12 mt-3">
            {{ sonata_block_render({ 'type': 'badpixxel.widgets.collection' }, {
                'type':     'demo-custom',
                'channel':  null,
            }) }}
        </div>

    </div>
{% endblock %}
