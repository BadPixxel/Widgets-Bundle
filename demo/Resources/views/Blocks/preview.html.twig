{% trans_default_domain "SplashWidgetsBundle" %}   
{% extends "base.html.twig" %}

{% block title %}
    Widgets Blocks Preview
{% endblock %}    

{% block page_content %}

<div class='row justify-content-center'>
    <div class='col-12'>
        <p>
            Let's see what block <code>{{ Block.type }}</code> looks like!
        </p>

        <hr>
    </div>
    <div class='col-12 col-md-6'>
        {% include '@WidgetsDemo/Blocks/Preview/inputs.html.twig' %}
    </div>
    <div class='col-12 col-md-6'>
        {% include '@WidgetsDemo/Blocks/Preview/contents.html.twig' %}
    </div>
    <div class='col-12 col-md-10'>
        {% include '@WidgetsDemo/Blocks/List/contents.html.twig' %}
    </div>
</div>
{% endblock %}

