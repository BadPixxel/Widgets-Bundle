{% trans_default_domain "SplashWidgetsBundle" %}   

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            Use the Widget Factory to create an Empty Widget
        </h6>
    </div>
    <div class="card-body">

        <table class="table table-bordered">

            <thead>
                <td>Service</td>
                <td>Channels</td>
                <td>Origin</td>
                <td>Icon</td>
                <td>Title</td>
                <td>Description</td>
                <td>Try it!!</td>
            </thead>

            {% for Configurator in Configurators %}

            <tr>
                <td>
                    {{ Configurator.class }}
                </td>
                <td>
                    {{ Configurator.channels|default(["none"])|join(', ') }}
                </td>
                <td>
                    <twig:Widgets:Widget:Origin :widget="Configurator.service" />
                </td>
                <td>
                    <twig:Widgets:Widget:Icon :widget="Configurator.service" />
                </td>
                <td>
                    <twig:Widgets:Widget:Title :widget="Configurator.service" />
                </td>
                <td>
                    <twig:Widgets:Widget:Description :widget="Configurator.service" />
                </td>
                <td>
                    <a
                            href="{{ path(PreviewRoute, {"hash": Configurator.hash, bsMode: bsMode}) }}"
                            class="btn btn-labeled btn-primary"
                    >
                        <i class="far fa-smile-wink"></i>
                        Test me!
                    </a>
                </td>
            <tr>

            {% endfor %}
        </table>

    </div>
</div>