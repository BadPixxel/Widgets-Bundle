{% extends "base.html.twig" %}

{#
    Display Node Profile Title
#}
{% block headline %}
    Preview of a Widgets : <twig:Widgets:Widget:Title :widget="Widget" />
    <br />
    <small><code>{{ Configurator.class }}</code></small>
{% endblock %}    
    
{% block page_content %}

<div class='row'>

    <div class='col-12 col-md-6'>
        <h4>Widget Configurator</h4>

        <twig:Widget:Configurator:Card
                :configurator="Configurator"
                configuration="{{ { "mode": bsMode } }}"
        />
    </div>

    <div class='col-12 col-md-6'>
        <h4>Widget Preview (As Component)</h4>

        <twig:Widget
                :configurator="Configurator"
                configuration="{{ { "mode": bsMode } }}"
                loading="defer"
        />

    </div>

</div>

            
{% endblock %}

