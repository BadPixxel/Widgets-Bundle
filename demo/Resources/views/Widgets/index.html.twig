{% extends "base.html.twig" %}

{% block title %}
    List of Available Widgets in "{{ Channel|default("All") }}" channel
{% endblock %}    

{% block page_content %}
    <div class='row'>

        <div class='col-12'>
            <p>
                This is the list of Configured Widgets. You can create as many Widgets & Channels as needed.
            </p>

            <hr>
        </div>

        <div class='col-12 justify-content-center text-center my-2'>
            {% include '@WidgetsDemo/Widgets/List/selector.html.twig' %}
        </div>

        <div class='col-12'>
            {% include '@WidgetsDemo/Widgets/List/contents.html.twig' %}
        </div>

    </div>
{% endblock %}

