<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Bootstrap Test{% endblock %}</title>

    {% block stylesheets %}{% endblock %}

    {% block jquery %}{% endblock %}

    <style>
        body { padding: 20px; }
        .version-badge {
            position: fixed;
            top: 10px;
            right: 10px;
            font-size: 1.2rem;
            z-index: 9999;
        }
    </style>
</head>
<body>

    {% block body %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}

</body>
</html>
