{
    "name":             "badpixxel/widgets-bundle",
    "description":      "Easy Widgets & Information boxes for Symfony Applications",
    "type":             "symfony-bundle",
    "keywords":         ["symfony", "symfony-ux", "Bundle", "Widget", "PHP", "Simple", "Bootstrap"],
    "homepage":         "https://www.badpixxel.com",
    "license":          "MIT",
    "prefer-stable":    true,
    "minimum-stability": "dev",

    "authors": [
        {
            "name":     "Splash Sync",
            "email":    "contact@splashsync.com"
        },
        {
            "name":     "Bernard Paquier",
            "email":    "eshop.bpaquier@gmail.com"
        }
    ],

    "autoload": {
        "psr-4": {
            "BadPixxel\\Widgets\\":                      "src"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "BadPixxel\\Widgets\\Demo\\":               "demo",
            "BadPixxel\\Widgets\\Tests\\":              "tests"
        }
    },

    "require": {
        "php":                                          "^8.1",
        "ext-json":                                     "*",

        "symfony/http-kernel":                          "^6.4|^7.0",
        "symfony/routing":                              "^6.4|^7.0",
        "symfony/dependency-injection":                 "^6.4|^7.0",
        "symfony/twig-bundle":                          "^6.4|^7.0",
        "symfony/asset-mapper":                         "^6.4|^7.0",
        "symfony/asset":                                "^6.4|^7.0",
        "symfony/form":                                 "^6.4|^7.0",
        "symfony/ux-live-component":                    "^2.0",
        "symfony/ux-chartjs":                           "^2.9",

        "doctrine/orm":                                 "^2.14",
        "doctrine/doctrine-bundle":                     "^2.0",

        "webmozart/assert":                             "^1.0",
        "knplabs/knp-time-bundle":                      "^1.6|^2.0",
        "knplabs/knp-menu-bundle":                      "~2.0|~3.0"
    },

    "require-dev": {
        "ext-curl":                                     "*",

        "badpixxel/php-sdk":                            "^2.0|^3.0",
        "sonata-project/admin-bundle":                  "^4.0",
        "sonata-project/block-bundle":                  "^4.0|^5.0",

        "symfony/runtime":                              "^6.4|^7.0",
        "symfony/dotenv":                               "^6.4|^7.0",
        "symfony/browser-kit":                          "^6.4|^7.0",
        "symfony/phpunit-bridge":                       "^6.4|^7.0",
        "symfony/web-profiler-bundle":                  "^6.4|^7.0",
        "symfony/webpack-encore-bundle":                "^2.0",
        "symfony/debug-bundle":                         "^6.4|^7.0",
        "symfony/css-selector":                         "^6.4|^7.0",

        "symfony/monolog-bundle":                       "^2.0|^3.0",
        "symfony/flex":                                 "^1.0",
        "twig/extra-bundle":                            "^2.12|^3.0",
        "twig/twig":                                    "^2.12|^3.0"
    },

    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "doctrine:schema:update --force": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]

    },

    "config": {
        "allow-plugins": {
            "phpro/grumphp":        true,
            "phpro/grumphp-shim":   true,
            "symfony/runtime":      true,
            "symfony/flex":         true
        }
    },

    "archive": {
        "exclude": ["/bin", "/tests", "/docker"]
    },

    "extra": {
        "public-dir": "tests/public",
        "symfony": {
            "allow-contrib": false
        }
    }
}
