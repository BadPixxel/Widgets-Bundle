{
    "name":             "badpixxel/widgets-bundle",
    "description":      "Easy Widgets & Information boxes for Symfony Applications",
    "type":             "symfony-bundle",
    "keywords":         ["Symfony", "Bundle", "Widget", "PHP", "Simple", "Bootstrap"],
    "homepage":         "https://www.badpixxel.com",
    "license":          "MIT",
    "prefer-stable":    true,
    "minimum-stability": "dev",

    "authors": [
        {
            "name":"Splash Sync",
            "email":"contact@splashsync.com"
        },
        {
            "name": "Bernard Paquier",
            "email": "eshop.bpaquier@gmail.com"
        }
    ],
    
    "autoload": {
        "psr-4": {
            "BadPixxel\\Widgets\\": "src"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "BadPixxel\\Widgets\\Demo\\": "demo",
            "BadPixxel\\Widgets\\Tests\\": "tests"
        }
    },
    
    "require": {
        "php":                                          "^8.1",
        "ext-json":                                     "*",

        "symfony/http-kernel":                          "^5.4|^6.4|^7.0",
        "symfony/routing":                              "^5.4|^6.4|^7.0",
        "symfony/dependency-injection":                 "^5.4|^6.4|^7.0",
        "symfony/twig-bundle":                          "^5.4|^6.4|^7.0",
        "symfony/ux-live-component":                    "^2.0",
        "symfony/ux-chartjs":                           "^2.9",

        "doctrine/orm":                                 "^2.14",
        "doctrine/doctrine-bundle":                     "^2.0",

        "webmozart/assert":                             "^1.0",
        "knplabs/knp-time-bundle":                      "^1.6|^2.0",
        "knplabs/knp-menu-bundle":                      "~2.0|~3.0",

        "sonata-project/block-bundle":                  "~3.0|~4.0|~5.0"
    },
    
    "require-dev": {
        "ext-curl":                                     "*",

        "badpixxel/php-sdk":                            "^2.0|^3.0",
        "sonata-project/admin-bundle":                  "^4.0",

        "symfony/runtime":                              "^5.4|^6.4|^7.0",
        "symfony/dotenv":                               "^5.4|^6.4|^7.0",
        "symfony/browser-kit":                          "^5.4|^6.4|^7.0",
        "symfony/phpunit-bridge":                       "^5.4|^6.4|^7.0",
        "symfony/web-profiler-bundle":                  "^5.4|^6.4|^7.0",
        "symfony/webpack-encore-bundle":                "^2.0",
        "symfony/debug-bundle":                         "^5.4|^6.4|^7.0",
        "symfony/css-selector":                         "^5.4|^6.4|^7.0",

        "symfony/monolog-bundle":                       "^2.0|^3.0",
        "symfony/flex":                                 "^1.0"
    },
    
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    
    "config": {
        "allow-plugins": {
            "phpro/grumphp":        true,
            "phpro/grumphp-shim":   true,
            "symfony/runtime":      true,
            "symfony/flex":         true
        }
    },

    "archive": {
        "exclude": ["/bin", "/tests", "/docker"]
    },

    "extra": {
        "config-dir": "tests/config",
        "public-dir": "tests/public",
        "symfony": {
            "allow-contrib": true
        }
    }
}
