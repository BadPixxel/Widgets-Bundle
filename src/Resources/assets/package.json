{
  "name":         "@badpixxel/ux-widgets",
  "description":  "BadPixxel Widgets Assets",
  "type":         "module",
  "main":         "widgets.js",
  "version":      "3.0.0-dev",
  "license":      "MIT",
  "keywords":     ["symfony-ux", "twig", "components"],

  "symfony": {
      "needsPackageAsADependency":        true,
      "importmap": {
          "jquery":                       "*",
          "chart.js":                     "^3.4.1 || ^4.0",
          "chart.js/auto":                "^3.4.1 || ^4.0",
          "chart.js/helpers":             "^3.4.1 || ^4.0",
          "chartjs-chart-matrix":         "^1.3",
          "chartjs-chart-sankey":         "^0.14.0",
          "@badpixxel/ux-widgets":        "path:%PACKAGE%/../public/widgets.js",
          "@badpixxel/ux-widgets-app":    "path:%PACKAGE%/../public/widgets-app.js"
      },
      "entrypoints": ["@badpixxel/ux-widgets-app"]
  },

  "dependencies": {
      "jquery":                           "*",
      "chart.js":                         "^3.4.1 || ^4.0",
      "chartjs-chart-matrix":             "^1.3",
      "chartjs-chart-sankey":             "^0.14.0"
  },

  "peerDependencies": {
      "jquery":                           "*",
      "chart.js":                         "^3.4.1 || ^4.0",
      "chartjs-chart-matrix":             "^1.3",
      "chartjs-chart-sankey":             "^0.14.0"
  }
}
