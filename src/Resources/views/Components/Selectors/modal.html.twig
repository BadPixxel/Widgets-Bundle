{% trans_default_domain "BadPixxelWidgets" %}

<div
    {{ attributes.defaults(stimulus_controller('BadPixxelWidgetsModalController')) }}
>

    <div  class="modal show" tabindex="-1" role="dialog">

        <div class="modal-dialog modal-lg" role="document" style="z-index:2000;">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">
                        {{ 'list.title'|trans }}
                        <small class="mb-0">{{ 'list.tooltip'|trans }}</small>
                    </h4>
                </div>

                <div class="modal-body">
                    {% include '@BadpixxelWidgets/Components/Selectors/contents.html.twig' %}
                </div>

                <div class="modal-footer">
                    <button
                            type="button" class="btn btn-secondary"
                            data-action="live#action"
                            data-live-action-param="close"
                    >
                        Close
                    </button>
                </div>

            </div>
        </div>

    </div>

</div>
