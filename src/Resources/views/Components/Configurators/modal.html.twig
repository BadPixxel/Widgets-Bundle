
{% form_theme this.getFormView() 'bootstrap_4_layout.html.twig' %}

<div
    {{ attributes.defaults(stimulus_controller('BadPixxelWidgetsModalController')) }}
>

    <div class="modal show" tabindex="-1" role="dialog" >

        <div class="modal-dialog" role="document" data-live-ignore>

            <div class="modal-content">


                {{ form_start(this.getFormView(), {
                    attr: {
                        'class': 'mb-0 px-0 ',
                        'data-action': 'live#action:prevent',
                        'data-live-action-param': 'saveAndClose'
                    }
                }) }}

                <div class="modal-header">
                    <h5 class="modal-title">
                        <twig:Widgets:Widget:Icon :widget="this.widget" />
                        <twig:Widgets:Widget:Title :widget="this.widget" />
                    </h5>
                    <button
                            type="button" class="close"
                            aria-label="Close"
                            data-action="live#action"
                            data-live-action-param="close"
                    >
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    {{ form_widget(this.getFormView(), { 'show_legend': false }) }}
                </div>

                <div class="modal-footer">

                    <twig:Widgets:Stimulus:Button
                            class="btn-primary"
                            icon="fa fa-fw fa-save"
                            text="widget.save"
                            translationDomain="BadPixxelWidgets"
                            action="saveAndClose"
                    />

                    <twig:Widgets:Stimulus:Button
                            class="btn-default"
                            icon="fa fa-fw fa-times"
                            text="actions.close"
                            translationDomain="BadPixxelWidgets"
                            action="close"
                    />

                </div>

                {{ form_end(this.getFormView()) }}

            </div>

        </div>
    </div>

</div>


