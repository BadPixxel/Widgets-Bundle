
{% trans_default_domain "BadPixxelWidgetsBundle" %}

{% if configuration.mode == 'bs3' %}
    {% form_theme form 'bootstrap_3_layout.html.twig' %}
{% elseif configuration.mode == 'bs4' %}
    {% form_theme form 'bootstrap_4_layout.html.twig' %}
{% else %}
    {% form_theme form 'bootstrap_5_layout.html.twig' %}
{% endif %}

<div  class="{{ this.mainDivClass }}" {{ attributes }} >

    <div class="{{ this.headerDivClass }}">
        <twig:Widgets:Widget:Icon :widget="this.widget" />
        <twig:Widgets:Widget:Title :widget="this.widget" />
    </div>

    {{ form_start(form, {
        attr: {
            'class': 'mb-0 px-0',
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save'
        }
    }) }}

    <div class="{{ this.bodyDivClass }}">
        {{ form_widget(form, { 'show_legend': false }) }}
    </div>

    <div class="{{ this.footerDivClass }}">
        <twig:Widgets:Stimulus:Button
                class="btn-primary"
                icon="fa fa-fw fa-save"
                text="widget.save"
                translationDomain="BadPixxelWidgets"
                action="save"
        />
    </div>

    {{ form_end(form) }}

</div>


