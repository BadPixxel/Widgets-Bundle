
{% if widget.options.Footer or configuration.edited %}
    <div class="{{ this.divClass }}">
        <small>
            {% if widget.refreshAt | default("Now") is not empty %}
                {{ widget.refreshAt | ago | default("Now") }}
            {% endif %}
            &nbsp;|&nbsp;<twig:Widgets:Widget:Origin :widget="widget" />&nbsp;|&nbsp;
            <twig:Widgets:Stimulus:Icon class="btn-info text-xs" icon="fa fa-fw fa-sync" action="refresh" />

            {% if widget.options.Editable | default(false) %}
                <twig:Widgets:Stimulus:Icon icon="fa fa-fw fa-cog" action="openEditor" />
            {% endif %}

            {% if configuration.edited and configuration.deletable %}
                <twig:Widgets:Stimulus:Icon icon="fa fa-fw fa-trash text-danger" action="delete" />
            {% endif %}

        </small>
    </div>
{% endif %}