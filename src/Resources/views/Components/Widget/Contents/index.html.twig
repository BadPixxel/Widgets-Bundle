
{% if widget.options.Border %}
<div
        class="{{ this.boxClass }}"
        style="{{ this.boxStyle }}"
>
    {% endif %}

    {# Widget Contents #}
    {% block widget_container %}

        {#  Widget Header #}
        {% block widget_header %}
            <twig:Widget:Header :widget="widget" :configuration="configuration" />
        {% endblock %}


        {# Widget Contents #}
        {% block widget_contents %}

                {# Show Widget Contents in View Mode #}
                {% if this.allowedLoading %}
                <div data-loading="show">
                    <twig:Widgets:Loading />
                </div>
                {% endif %}

                <div {% if this.allowedLoading %}data-loading="hide"{% endif %}>
                    {% if configuration.edited|default(false) %}

                        {# Show Configurator in Edit Mode #}
                        <twig:Widget:Configurator:Embedded
                                :key="key"
                                :configuratorHash="configuratorHash"
                                :configuration="configuration"
                                :options="widget.options"
                                :parameters="widget.parameters"
                        />

                    {% else %}

                        {# Widget Block Row #}
                        <div class="row no-padding justify-content-around">
                            {% block widget_row %}
                                {% if widget.Blocks is defined %}
                                    <twig:Widget:Blocks :widget="widget" :configuration="configuration" />
                                {% endif %}
                            {% endblock %}
                        </div>

                    {% endif %}
                </div>
        {% endblock %}


        {# Widget Footer #}
        {% block widget_footer %}
            <twig:Widget:Footer :widget="widget" :configuration="configuration" />
        {% endblock %}

    {% endblock %}

    {% if widget.options.Border %}
</div>
{% endif %}
