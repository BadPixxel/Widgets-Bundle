<div
        {{ attributes }}
        class="{{ widget.options.Class|default("splash-widget mb-3")}} {{ this.divClass }} "
        data-id="{{ key }}"
>

    {% if configuration.sortable %}
        <twig:Widget:Mover
                :widget="widget"
                :configuration="configuration"
                :key="key"
                :configuratorHash="configuratorHash"
                :position="position"
                :total="total"
        />
    {% endif %}

    <twig:Widget:Contents
            :widget="widget"
            :configuration="configuration"
            :key="key"
            :configuratorHash="configuratorHash"
    />

</div>

{% macro placeholder(props) %}
    <twig:Widgets:Loading />
{% endmacro %}



