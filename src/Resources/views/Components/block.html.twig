
{#
    RENDER A UNIQUE BLOCK
#}
<div class="{{ block.options.Width }}">

    {% if renderer is not empty %}
        {{ component(renderer, { "block": block }) }}
    {% else %}
        <p class="text-danger">
            {{ "blocks.renderer-not-found"|trans({}, "BadPixxelWidgets") }}
        </p>
    {% endif %}

</div>