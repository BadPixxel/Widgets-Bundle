{% trans_default_domain "BadPixxelWidgets" %}

<div class="row mb-4" {{ attributes }}>

    {% if addMode|default(false) %}
        <div class="col-12">
            <twig:Widget:Selector:Card :collection="collection" />
        </div>
    {% else %}


        <div class="col-12 col-md-6">
            <div class="h3">
                <twig:Widgets:Collection:Icon :collection="collection" />
                <twig:Widgets:Collection:Title :collection="collection" />
            </div>
        </div>

        <div class="{{ this.actionsColClass }}">

            <div class="{{ this.toolbarClass }}" role="toolbar">

                <twig:Widgets:Collection:PresetSelector :collection="collection" />

                {% if configuration.editable %}

                    <twig:Widgets:Stimulus:Button
                            class="btn-secondary px-3 {{ this.buttonSpacingClass }}"
                            icon="fa fa-fw fa-plus-circle"
                            text="widget.add"
                            translationDomain="BadPixxelWidgets"
                            action="startAdd"
                    />

                    {% if configuration.edited %}
                        <twig:Widgets:Stimulus:Button
                                class="btn-success  px-3"
                                icon="fa fa-fw fa-eye"
                                text="widget.view"
                                translationDomain="BadPixxelWidgets"
                                action="closeEditor"
                        />
                    {% else %}
                        <twig:Widgets:Stimulus:Button
                                class="btn-primary px-3"
                                icon="fa fa-fw fa-cogs"
                                text="widget.edit"
                                translationDomain="BadPixxelWidgets"
                                action="startEditor"
                        />
                    {% endif %}
                {% endif %}

            </div>
        </div>


    {% endif %}
</div>
        
