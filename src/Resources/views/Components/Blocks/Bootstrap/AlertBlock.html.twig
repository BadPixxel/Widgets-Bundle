{#
 # Blocks do not know the rendering mode: the dismiss button works on Bootstrap 3, 4 & 5.
 # Bootstrap 5 draws .btn-close, and hides the text with .visually-hidden (unknown to BS3 & BS4).
 #}
<div class="{{ this.alertClass }}{% if data.dismissible|default(false) %} alert-dismissible{% endif %} no-margin">

    {% if data.dismissible|default(false) %}
        <button type="button" class="close btn-close" aria-label="Close"
                data-dismiss="alert" data-bs-dismiss="alert">
            <span aria-hidden="true" class="visually-hidden">&times;</span>
        </button>
    {% endif %}

    {% if data.title is not empty %}
        <div class="h5 alert-heading">
            {% if data.icon is defined and data.icon is not empty %}
                <i class="{{ data.icon }}"></i>
            {% endif %}

            {% if this.options.AllowHtml %} {{ data.title | raw  }} {% else %} {{ data.title }} {% endif %}

        </div>
    {% else %}
        {% if data.icon is defined and data.icon is not empty %}
            <i class="{{ data.icon }}"></i>
        {% endif %}
    {% endif %}

    {% if this.options.AllowHtml %} {{ data.text | raw  }} {% else %} {{ data.text }} {% endif %}
</div>

    
    