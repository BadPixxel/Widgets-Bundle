
{% trans_default_domain "SplashWidgetsBundle" %}   
{% form_theme form 'bootstrap_4_layout.html.twig' %}

<div class="modal fade" id="{{ widgetId }}-EditModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document" style="z-index:2000;">

        {{ form_start(form, {
            attr: {
                'data-action': 'live#action',
                'data-action-name': 'prevent|save'
            }
        }) }}

        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title">
                    {{ "parameters.title" | trans }}
                </h4>
                <button type="button" class="close hidden" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>

            <div class="modal-body">
                {{ form_widget(form, { 'show_legend': false}) }}
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-default"
                        data-dismiss="modal"
                        data-action="live#action"
                        data-action-name="closeEditor"
                >
                    Close
                </button>
                <button type="submit" class="btn btn-primary"
                        data-action="live#action"
                        data-action-name="save"
                >
                    Save changes
                </button>
            </div>

        </div>

        {{ form_end(form) }}

    </div>
</div>
